{
  "name": "binance-research-pro-workspace",
  "version": "0.4.4",
  "private": true,
  "description": "Monorepo for the Binance Research Pro Codex plugin and private MCP server",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace packages/mcp",
    "dev:mcp": "npm run dev --workspace packages/mcp",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint --workspace packages/mcp",
    "test": "npm run test --workspace packages/mcp",
    "test:mcp": "npm run test:mcp --workspace packages/mcp",
    "test:mcp:live": "npm run test:mcp:live --workspace packages/mcp",
    "test:package": "npm run test:package --workspace packages/mcp",
    "check:plugin": "node scripts/run-plugin-validator.mjs",
    "check:skill-tools": "node scripts/check-skill-tools.mjs",
    "check:versions": "node scripts/check-version-sync.mjs",
    "check:plugin-release": "node scripts/check-version-sync.mjs --require-current",
    "check:final-release": "node scripts/check-version-sync.mjs --require-current --require-final-tag",
    "check": "npm run format:check && npm run lint && npm run build && npm run test && npm run test:mcp && npm run check:plugin && npm run check:skill-tools && npm run check:versions",
    "release:check": "npm run check && npm run test:package",
    "plugin:release-check": "npm run check && npm run check:plugin-release"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "prettier": "^3.5.3"
  }
}
