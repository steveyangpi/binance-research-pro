{
  "name": "binance-analysis-mcp",
  "version": "0.2.0",
  "private": true,
  "description": "Binance market-analysis MCP server with a local DuckDB/Parquet warehouse",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:mcp": "node scripts/mcp-smoke-test.mjs",
    "test:mcp:live": "node scripts/mcp-smoke-test.mjs --live",
    "check": "npm run format:check && npm run lint && npm run build && npm run test"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.5-r.4",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "adm-zip": "^0.6.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.15.30",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "globals": "^16.1.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0",
    "vitest": "^3.2.3"
  }
}
