# Public market-data endpoints do not require credentials.
# Change only if Binance documents an appropriate regional endpoint for your account.
BINANCE_REST_BASE_URL=https://api.binance.com
BINANCE_FUTURES_REST_BASE_URL=https://fapi.binance.com
# Request timeout and public market-data cache duration, in milliseconds.
BINANCE_REQUEST_TIMEOUT_MS=10000
BINANCE_CACHE_TTL_MS=15000
BINANCE_CANDLE_CACHE_TTL_MS=60000
BINANCE_FUNDING_CACHE_TTL_MS=600000
# Optional single root for all stateful data. When omitted, the server uses the
# operating system's per-user application-data directory.
# BINANCE_RESEARCH_DATA_DIR=D:\BinanceResearchPro

# SQLite persists public API responses across MCP process restarts.
BINANCE_PERSISTENT_CACHE_ENABLED=true
BINANCE_CACHE_MAX_ENTRIES=10000

# Historical data warehouse. These paths are derived from BINANCE_RESEARCH_DATA_DIR.
WAREHOUSE_ENABLED=true
WAREHOUSE_MAX_IMPORT_BYTES=536870912
WAREHOUSE_DOWNLOAD_TIMEOUT_MS=120000

# Advanced per-path overrides take precedence over BINANCE_RESEARCH_DATA_DIR.
# BINANCE_CACHE_DB_PATH=D:\BinanceResearchPro\cache\market-cache.sqlite
# WAREHOUSE_PARQUET_ROOT=D:\BinanceResearchPro\warehouse\parquet
# WAREHOUSE_METADATA_DB_PATH=D:\BinanceResearchPro\warehouse\metadata.sqlite
# WAREHOUSE_TEMP_DIR=D:\BinanceResearchPro\warehouse\tmp
# WAREHOUSE_IMPORT_ROOTS=D:\BinanceResearchPro\imports
